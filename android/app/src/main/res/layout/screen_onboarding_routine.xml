<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="34dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Build Your Wellness Routine"
        android:textColor="@color/ink"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Pick a practice you want to master every day."
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/routine_breathe"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁" android:textColor="@color/login_blue" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Morning&#10;Mindfulness" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="5 min • Start" android:textColor="@color/muted_ink" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/routine_journal"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☼" android:textColor="@color/register_teal" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Afternoon&#10;Recharge" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="5 min • Start" android:textColor="@color/muted_ink" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/routine_comfort"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textColor="@color/login_blue" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Evening&#10;Reflection" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="5 min • Start" android:textColor="@color/muted_ink" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/routine_night"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☾" android:textColor="@color/register_teal" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Before Bed&#10;Relax" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="5 min • Start" android:textColor="@color/muted_ink" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/routine_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Select a routine"
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="5 min    10 min    15 min"
        android:textColor="@color/login_blue"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="•  •  •  •  ━"
        android:textColor="@color/login_blue"
        android:textSize="15sp" />

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/routine_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_register_button"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
