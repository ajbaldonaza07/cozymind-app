<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="34dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="How are you feeling today?"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Choose how you feel. Your answer can change anytime."
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/onboarding_mood_happy"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_happy" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Happy" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/onboarding_mood_stressed"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_stressed" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Stressed" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/onboarding_mood_calm"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_calm" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Calm" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/onboarding_mood_anxious"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_anxious" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Anxious" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/onboarding_mood_motivated"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_motivated" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Motivated" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/onboarding_mood_neutral"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <View android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/bg_mood_neutral" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Neutral" android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/onboarding_mood_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:gravity="center"
        android:text="Select a feeling"
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="•  •  •  ━  •"
        android:textColor="@color/login_blue"
        android:textSize="15sp" />

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/onboarding_mood_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_register_button"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
