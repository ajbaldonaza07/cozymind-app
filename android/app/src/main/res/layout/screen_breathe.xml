<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        android:id="@+id/back_from_breathe"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="‹  Back to dashboard"
        android:textColor="@color/register_teal"
        android:textSize="14sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONE MINUTE RESET"
        android:textColor="@color/register_teal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/breath_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:text="Take a slow breath"
        android:textColor="@color/ink"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/breath_countdown"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_logo"
        android:gravity="center"
        android:text="—"
        android:textColor="@color/register_teal"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/breath_round"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="4 gentle rounds • in 4, hold 4, out 6"
        android:textColor="@color/muted_ink"
        android:textSize="14sp" />

    <Button
        android:id="@+id/start_breathing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_register_button"
        android:text="Start breathing"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="If this does not feel helpful, stop and choose a different gentle activity."
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />
</LinearLayout>
