<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="34dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Feel Your Calm"
        android:textColor="@color/ink"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="What would you like to focus on?"
        android:textColor="@color/muted_ink"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/focus_relax"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:text="☁\nRelax"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/focus_calm"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:text="♨\nCalm Down"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/focus_focus"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:text="◎\nFocus"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/focus_selfcare"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_card"
            android:text="♡\nSelf-Care"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/focus_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Choose what feels most helpful today."
        android:textColor="@color/muted_ink"
        android:textSize="14sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/focus_continue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_register_button"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
