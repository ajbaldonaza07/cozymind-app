      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health.php"
          ]
        }
      }
    },
