<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="♡"
            android:textColor="@color/login_blue"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cozymind"
            android:textColor="@color/login_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Welcome"
            android:textColor="@color/ink"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A quiet space for whatever today feels like."
            android:textColor="@color/muted_ink"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/login_email"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:hint="Email or username"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted_ink"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/login_password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="9dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="Need help?"
            android:textColor="@color/login_blue"
            android:textSize="13sp" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_button"
            android:text="Log in"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="or"
            android:textColor="@color/muted_ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/open_signup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_outline_button"
            android:text="Sign up"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="By continuing you agree to take things one step at a time."
            android:textColor="@color/nav_inactive"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
