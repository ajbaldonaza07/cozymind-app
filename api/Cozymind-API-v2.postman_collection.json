            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"username\": \"testuser\",\n  \"email\": \"test@cozymind.local\",\n  \"phone_number\": \"09123456789\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
