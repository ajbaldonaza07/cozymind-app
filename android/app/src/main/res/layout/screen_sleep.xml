<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="27dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/back_from_sleep"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_outline_button"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/dark_pill"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Sleep Log"
                    android:textColor="@color/dark_pill"
                    android:textSize="29sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rest is part of feeling well. Notice how you sleep."
                android:textColor="@color/muted_ink"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_lilac_card"
                android:orientation="vertical"
                android:padding="19dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOG LAST NIGHT"
                    android:textColor="@color/ink"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Date (YYYY-MM-DD)"
                    android:textColor="@color/muted_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/sleep_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="2026-10-25"
                    android:inputType="date"
                    android:maxLength="10"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted_ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bedtime (HH:MM)"
                            android:textColor="@color/muted_ink"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/sleep_bed_time"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:hint="22:30"
                            android:inputType="time"
                            android:maxLength="5"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted_ink" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wake up (HH:MM)"
                            android:textColor="@color/muted_ink"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/sleep_wake_time"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:hint="06:30"
                            android:inputType="time"
                            android:maxLength="5"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted_ink" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="How well did you sleep?"
                    android:textColor="@color/muted_ink"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/sleep_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/sleep_q1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1"
                        android:textColor="@color/ink" />

                    <RadioButton
                        android:id="@+id/sleep_q2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2"
                        android:textColor="@color/ink" />

                    <RadioButton
                        android:id="@+id/sleep_q3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="3"
                        android:textColor="@color/ink" />

                    <RadioButton
                        android:id="@+id/sleep_q4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4"
                        android:textColor="@color/ink" />

                    <RadioButton
                        android:id="@+id/sleep_q5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5"
                        android:textColor="@color/ink" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = restless · 5 = deeply rested"
                    android:textColor="@color/muted_ink"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/sleep_notes"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Notes (optional)"
                    android:inputType="textCapSentences"
                    android:maxLength="255"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted_ink" />

                <Button
                    android:id="@+id/save_sleep"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_register_button"
                    android:text="Save sleep log"
                    android:textAllCaps="false"
                    android:textColor="@color/surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Recent nights"
                android:textColor="@color/dark_pill"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap an entry to remove it."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/sleep_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
