<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="34dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="♡"
        android:textColor="@color/login_blue"
        android:textSize="26sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="26dp" />

    <ImageView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:contentDescription="Calming companion"
        android:scaleType="centerInside"
        android:src="@drawable/figma_meditation" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:text="Find Your Inner Calm"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Daily sessions to help you relax, focus, and grow."
        android:textColor="@color/muted_ink"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="━  •  •  •"
        android:textColor="@color/login_blue"
        android:textSize="17sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/get_started"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_register_button"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
