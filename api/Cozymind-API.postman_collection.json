            {
              "key": "action",
              "value": "login"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identity\": \"testuser\",\n  \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
