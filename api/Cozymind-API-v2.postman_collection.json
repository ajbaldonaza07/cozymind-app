{
  "info": {
    "name": "Cozymind API v2 (per-file endpoints)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom: Register/Login first. Postman stores the PHPSESSID cookie automatically. IDs from Create/Register responses are saved into collection variables, so View/Update/Delete work without editing."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/cozymind-app-main/api"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "new_user_id",
      "value": ""
    },
    {
      "key": "mood_id",
      "value": ""
    },
    {
      "key": "journal_id",
      "value": ""
    },
    {
      "key": "goal_id",
      "value": ""
    },
    {
      "key": "sleep_log_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health.php"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is one of [200]', function () { pm.expect([200]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/authentication/register.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "register.php"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"username\": \"testuser\",\n  \"email\": \"test@cozymind.local\",\n  \"phone_number\": \"09171234567\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 on success (409 if already registered - then use Login). Logs you in; Postman keeps the PHPSESSID cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of [201, 409]', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (json.user && json.user.id) { pm.collectionVariables.set('user_id', json.user && json.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
