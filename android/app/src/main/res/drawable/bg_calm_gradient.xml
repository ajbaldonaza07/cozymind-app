<?xml version="1.0" encoding="utf-8"?>
<!-- Sage-to-cream backdrop with two soft floating bubbles in the corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/calm_mid"
                android:endColor="@color/screen_background"
                android:startColor="@color/calm_top" />
        </shape>
    </item>
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|end"
        android:right="-110dp"
        android:top="-90dp">
        <shape android:shape="oval">
            <solid android:color="#33A9D3C4" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:bottom="-90dp"
        android:gravity="bottom|start"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#26B9AEEA" />
        </shape>
    </item>
</layer-list>
